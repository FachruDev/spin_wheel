# Berlaku untuk semua paket. Aturan khusus Flutter ada di undian_flutter/.gitignore,
# aturan khusus server di undian_server/.gitignore.

# Dart / Flutter
.dart_tool/
.flutter-plugins-dependencies
build/

# IDE
.idea/
*.iml

# Rahasia dan data di VPS
.env
deploy/backups/
deploy/certbot/
**/config/passwords.yaml

# Data contoh/asli dari Excel tidak boleh masuk repo publik (kecuali template kosong)
*.xls
*.xlsx
!undian_flutter/assets/templates/*.xlsx
