# Dua domain di satu nginx:
#   ${APP_DOMAIN} → aplikasi Flutter web (file statis)
#   ${API_DOMAIN} → API Serverpod (termasuk WebSocket untuk layar panggung realtime)
# Satu sertifikat Let's Encrypt mencakup keduanya, disimpan di live/${APP_DOMAIN}/.

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 80;
    listen [::]:80;
    server_name ${APP_DOMAIN} ${API_DOMAIN};

    # Tantangan verifikasi Let's Encrypt saat memperpanjang sertifikat.
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name ${APP_DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${APP_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${APP_DOMAIN}/privkey.pem;
    include /etc/nginx/conf.d/snippets/ssl.inc;
    include /etc/nginx/conf.d/snippets/headers.inc;

    root /usr/share/nginx/html;
    index index.html;

    # Aplikasi satu halaman: semua rute diarahkan ke index.html.
    location / {
        try_files $uri $uri/ /index.html;
    }

    # File yang namanya tetap tidak boleh di-cache lama, supaya versi baru langsung terpakai.
    location ~* ^/(index\.html|flutter_bootstrap\.js|flutter_service_worker\.js|version\.json|manifest\.json)$ {
        include /etc/nginx/conf.d/snippets/headers.inc;
        add_header Cache-Control "no-cache";
    }

    location ~* \.(?:js|wasm|css|png|jpg|svg|ico|ttf|otf|woff2?)$ {
        include /etc/nginx/conf.d/snippets/headers.inc;
        add_header Cache-Control "public, max-age=604800";
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name ${API_DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${APP_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${APP_DOMAIN}/privkey.pem;
    include /etc/nginx/conf.d/snippets/ssl.inc;
    include /etc/nginx/conf.d/snippets/headers.inc;

    # Sedikit di atas maxRequestSize Serverpod (512 KB) untuk unggah logo.
    client_max_body_size 1m;

    location / {
        proxy_pass http://server:8080;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Koneksi WebSocket layar panggung bisa terbuka sepanjang acara.
        proxy_read_timeout 3600s;
    }
}
