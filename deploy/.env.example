# Salin menjadi deploy/.env lalu isi. File .env berisi rahasia dan TIDAK boleh di-commit.
# Buat nilai acak dengan:  openssl rand -base64 48

# Domain yang sudah diarahkan (A record) ke IP VPS.
APP_DOMAIN=undian.contoh.co.id
API_DOMAIN=api.undian.contoh.co.id

# Email untuk notifikasi Let's Encrypt (sertifikat HTTPS).
CERTBOT_EMAIL=admin@contoh.co.id

# Password database PostgreSQL.
DB_PASSWORD=

# Rahasia Serverpod dan modul login. Jangan diganti setelah aplikasi dipakai:
# mengganti pepper/kunci membuat semua sesi login dan kode verifikasi lama tidak berlaku.
SERVICE_SECRET=
EMAIL_SECRET_HASH_PEPPER=
JWT_REFRESH_TOKEN_HASH_PEPPER=
JWT_HMAC_SHA512_PRIVATE_KEY=

# Opsional untuk scripts/backup.sh: tujuan salinan backup di luar VPS (rsync),
# mis. backup@server-lain:/backup/undian
OFFSITE_TARGET=
